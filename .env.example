# ---- AWS (NUNCA credenciales reales en el repo) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bucket destino del data lake
S3_BUCKET=BUCKET-DEL-PROYECTO
S3_PREFIX=raw/

# Todas las bases corren como contenedores en la VM de base de datos:
# usar su IP PRIVADA, nunca localhost.

# ---- ingesta01: PostgreSQL (ms-residentes) ----
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=condominio_residentes
POSTGRES_USER=
POSTGRES_PASSWORD=

# Tablas a exportar, separadas por coma. Si se deja vacio usa las de
# condominio_residentes: edificios, unidades, residentes.
#
# La base condominio_usuarios (del microservicio ms-usuarios) vive en el MISMO
# PostgreSQL. Para volcarla se usa el mismo contenedor cambiando dos variables:
#   POSTGRES_DB=condominio_usuarios
#   INGESTA_TABLAS=usuarios,sesiones
# El hash de las passwords nunca se exporta: la consulta excluye password_hash.
INGESTA_TABLAS=

# ---- ingesta02: MySQL (ms-pagos) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=condominio_pagos
MYSQL_USER=
MYSQL_PASSWORD=

# ---- ingesta03: MongoDB (ms-incidencias) ----
MONGO_URI=
MONGO_DB=condominio_incidencias
