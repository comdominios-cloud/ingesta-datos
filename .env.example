# ---- AWS (NUNCA credenciales reales en el repo) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bucket destino del data lake
S3_BUCKET=BUCKET-DEL-PROYECTO
S3_PREFIX=raw/

# Todas las bases corren como contenedores en la VM de base de datos:
# usar su IP PRIVADA, nunca localhost.

# ---- ingesta01: PostgreSQL (ms-residentes) ----
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=condominio_residentes
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- ingesta02: MySQL (ms-pagos) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=condominio_pagos
MYSQL_USER=
MYSQL_PASSWORD=

# ---- ingesta03: MongoDB (ms-incidencias) ----
MONGO_URI=
MONGO_DB=condominio_incidencias
